            rf"$D_s={kepler_info['Ds_kpc']:.3g}\,\mathrm{{kpc}}$" "\n"
            rf"$\pi_\mathrm{{rel}}={kepler_info['pi_rel_mas']:.3g}\,\mathrm{{mas}}$" "\n"
            rf"$\theta_E={kepler_info['thetaE_mas']:.3g}\,\mathrm{{mas}}$" "\n"
